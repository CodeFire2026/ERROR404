// Ejercicio 91: Matriz de 3×3 con llenado manual y mostrar su diagonal principal (Diagrama de flujo) .
Proceso Ejercicio91
    Definir m Como Entero;
    Dimension m[3,3];
    
    m[0,0]<-1; m[0,1]<-2; m[0,2]<-3;
    m[1,0]<-4; m[1,1]<-5; m[1,2]<-6;
    m[2,0]<-7; m[2,1]<-8; m[2,2]<-9;
    
    Escribir m[0,0];
    Escribir m[1,1];
    Escribir m[2,2];
FinProceso