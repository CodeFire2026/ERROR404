//(nombre, apellido, edad, altura, esMayorEdad) .
Proceso Primero
	definir nombre Como Caracter;
	Definir apellido Como Caracter;
	Definir edad Como Entero;
	Definir altura Como Real;
	definir esMayorEdad Como Logico;
	
	nombre <-"Federico";
	apellido <-"Vantuch";
	edad <-21;
	altura <- 1.75;
	esMayorEdad <-(edad > 18);
	
	Escribir "Su nombre es: ",nombre;
	Escribir "Su apellido es: ",apellido;
	Escribir "Su edad es: ",edad;
	Escribir "Su altura es: ",altura;
	Escribir "Eres mayor de edad: ",esMayorEdad;
FinProceso