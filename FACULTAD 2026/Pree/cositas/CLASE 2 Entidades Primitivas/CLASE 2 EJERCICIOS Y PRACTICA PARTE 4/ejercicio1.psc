Proceso Ejercicios
	//Ejercicio 1
	Definir a,b,c, resultado Como Real;
	Escribir "Digite su valor de A: ";
	Leer a;
	Escribir "Digite su valor de B: ";
	Leer b;
	Escribir "Digite su valor de C: ";
	Leer c;
	
	resultado <- (-b + rc(b^2 - 4 * a *c))/(2*a);
	
	Escribir "El resultado es: ", resultado;
	
	resultado <- (-b - rc(b^2 - 4 * a *c))/(2*a);
	
	Escribir "El resultado es: ", resultado;
	
FinProceso
