//	Ejercicio 17: Definir a= 78, que el usuario ingrese numero: ejecución paso a paso ingresando valores y calculando (a+b)/(a×b) (Pseudocódigo) .

Proceso ejercicio17
		Definir a, b Como Entero;
		Definir resultado Como Real;
		
		a <- 78;
		
		Escribir "Ingrese un numero:";
		Leer b;
		
		resultado <- (a + b) / (a * b);
		
		Escribir "Resultado: ", resultado;
FinProceso
