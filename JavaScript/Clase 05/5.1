let persona = {
    nombre: 'Carlos',
    apellido: 'Gil',
    email: 'cgil@gmail.com',
    edad: 30,

    // Forma 1: Función tradicional dentro de un objeto
    nombreCompleto: function() {
        return this.nombre + ' ' + this.apellido;
    },

    // Forma 2: Método GET (acceso como propiedad)
    get nombreEdad() {
        return 'El nombre es: ' + this.nombre + ', edad: ' + this.edad;
    }
}

// Visualización de la función tradicional (requiere paréntesis)
console.log(persona.nombreCompleto()); 

// Visualización del método GET
console.log('Comenzamos a utilizar el método get');
console.log(persona.nombreEdad); // No utiliza paréntesis