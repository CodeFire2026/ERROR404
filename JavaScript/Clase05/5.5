let persona = {
    nombre: 'Carlos',
    apellido: 'Gil',
    email: 'cgil@gmail.com',
    edad: 30,

    // Forma 1: Función tradicional dentro de un objeto
    nombreCompleto: function() {
        return this.nombre + ' ' + this.apellido;
    },

    // Forma 2: Método GET (acceso como propiedad)
    get nombreEdad() {
        return 'El nombre es: ' + this.nombre + ', edad: ' + this.edad;
    }
}

// Visualización de la función tradicional (requiere paréntesis)
console.log(persona.nombreCompleto()); 

// Visualización del método GET
console.log('Comenzamos a utilizar el método get');
console.log(persona.nombreEdad); // No utiliza paréntesis

console.log('Comenzamos a utilizar el método get');
console.log(persona.nombreEdad);

console.log('Comenzamos con el método get y set para idiomas');
persona.lang = 'en';
console.log(persona.lang);

function Persona3(nombre, apellido, email) { // constructor
    this.nombre = nombre;
    this.apellido = apellido;
    this.email = email;
    this.nombreCompleto = function() {
        return this.nombre + ' ' + this.apellido;
    }
}
let padre = new Persona3('Leo','Lopez','lopezl@gmail.com');
padre.nombre = 'Luis'; // modificamos el nombre
padre.telefono = '5492618282821'; //Una propiedad exclusiva del objeto padre
console.log(padre);
console.log(padre.telefono); //Accedemos a la propiedad
console.log(padre.nombreCompleto()); //Utilizamos la función
let madre = new Persona3('Laura', 'Contrera', 'contreral@gmail.com');
console.log(madre);
console.log(madre.telefono); //la propiedad no esta definida
console.log(madre.nombreCompleto());
