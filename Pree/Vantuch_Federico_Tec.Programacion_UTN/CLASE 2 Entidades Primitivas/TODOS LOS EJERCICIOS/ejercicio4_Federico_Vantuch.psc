//?	Ejercicio 4: Evaluar con una variable lógica si una persona es mayor de edad (Ej. esMayorEdad <- (edad > 18)).
Proceso ejercicio4
		Definir edad Como Entero;
		Definir esMayorEdad Como Logico;
		
		Escribir "Ingrese su edad:";
		Leer edad;
		
		esMayorEdad <- edad > 18;
		
		Escribir "¿Es mayor de edad?: ", esMayorEdad;
	
FinProceso
