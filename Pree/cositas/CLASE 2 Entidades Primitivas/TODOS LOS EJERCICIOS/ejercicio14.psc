//?	Ejercicio 14: 
//Hacer un programa para intercambiar el valor de 2 variables. (pseudocódigo)
Proceso ejercicio14
		Definir a, b, aux Como Entero;
		
		Escribir "Ingrese valor de a:";
		Leer a;
		Escribir "Ingrese valor de b:";
		Leer b;
		
		aux <- a;
		a <- b;
		b <- aux;
		
		Escribir "Ahora a vale: ", a;
		Escribir "Ahora b vale: ", b;
	
FinProceso
